      "edges": [
        { "edgeId": "a-b", "fromNodeId": "a", "toNodeId": "b", "distanceMm": 10, "objectiveCostUnits": 1 },
        { "edgeId": "b-d", "fromNodeId": "b", "toNodeId": "d", "distanceMm": 10, "objectiveCostUnits": 1 }
