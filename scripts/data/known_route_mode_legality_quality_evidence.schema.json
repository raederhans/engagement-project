{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engagement-project.local/schemas/KnownRouteModeLegalityQualityEvidence-v1.json",
  "title": "KnownRouteModeLegalityQualityEvidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "semantic_identity",
    "route_identity",
    "corridor_identity",
    "centerline_identity",
    "mode_legality",
    "match_quality",
    "authority",
    "privacy"
  ],
  "properties": {
    "schema": { "const": "KnownRouteModeLegalityQualityEvidence/v1" },
    "semantic_identity": { "$ref": "#/$defs/identity" },
    "route_identity": { "$ref": "#/$defs/identity" },
    "corridor_identity": { "$ref": "#/$defs/identity" },
    "centerline_identity": { "$ref": "#/$defs/identity" },
    "mode_legality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walking", "cycling", "driving", "transit"],
      "properties": {
        "walking": { "$ref": "#/$defs/modeLegality" },
        "cycling": { "$ref": "#/$defs/modeLegality" },
        "driving": { "$ref": "#/$defs/modeLegality" },
        "transit": { "$ref": "#/$defs/modeLegality" }
      }
    },
    "match_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "source_id",
        "source_version",
        "match_status",
        "candidate_margin_m",
        "maximum_distance_m",
        "ambiguity_count",
        "off_network_count",
        "disconnect_count",
        "calibration_status"
      ],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": {
          "enum": [
            "uncalibrated-deterministic-candidate",
            "ambiguous-map-match-candidate",
            "off-network-map-match-candidate",
            "disconnected-map-match-candidate",
            "map-match-unavailable"
          ]
        },
        "source_id": { "const": "philadelphia-street-centerline" },
        "source_version": { "$ref": "#/$defs/sourceVersion" },
        "match_status": { "enum": ["matched", "unavailable"] },
        "candidate_margin_m": { "$ref": "#/$defs/nullableDistance" },
        "maximum_distance_m": { "$ref": "#/$defs/nullableDistance" },
        "ambiguity_count": { "$ref": "#/$defs/binaryCounter" },
        "off_network_count": { "$ref": "#/$defs/binaryCounter" },
        "disconnect_count": { "$ref": "#/$defs/binaryCounter" },
        "calibration_status": { "const": "uncalibrated" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "routing", "safety"],
      "properties": {
        "mode": { "const": false },
        "routing": { "const": false },
        "safety": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_only",
        "route_coordinates_included",
        "geometry_included",
        "edge_ids_included",
        "raw_rows_included",
        "private_fields_included"
      ],
      "properties": {
        "aggregate_only": { "const": true },
        "route_coordinates_included": { "const": false },
        "geometry_included": { "const": false },
        "edge_ids_included": { "const": false },
        "raw_rows_included": { "const": false },
        "private_fields_included": { "const": false }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-f0-9]{16}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "sourceVersion": {
      "type": "string",
      "pattern": "^city-street-centerline:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nullableDistance": {
      "anyOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 100000 }
      ]
    },
    "binaryCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "encodedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_restrictions", "oneway", "access", "temporal", "turn", "boundary"],
      "properties": {
        "mode_restrictions": { "const": true },
        "oneway": { "const": true },
        "access": { "const": true },
        "temporal": { "const": true },
        "turn": { "const": true },
        "boundary": { "const": true }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "source_version",
        "mode",
        "route_identity",
        "corridor_identity",
        "centerline_identity",
        "encoded_evidence",
        "receipt_identity"
      ],
      "properties": {
        "schema": { "const": "KnownRouteModeRestrictionSourceReceipt/v1" },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "source_version": { "$ref": "#/$defs/sourceVersion" },
        "mode": { "enum": ["walking", "cycling", "driving", "transit"] },
        "route_identity": { "$ref": "#/$defs/identity" },
        "corridor_identity": { "$ref": "#/$defs/identity" },
        "centerline_identity": { "$ref": "#/$defs/identity" },
        "encoded_evidence": { "$ref": "#/$defs/encodedEvidence" },
        "receipt_identity": { "$ref": "#/$defs/identity" }
      }
    },
    "modeLegality": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": {
              "enum": [
                "mode-restriction-source-unavailable",
                "map-match-unavailable",
                "mode-restriction-contract-mismatch",
                "mode-restriction-source-version-missing",
                "mode-restriction-source-version-mismatch",
                "mode-restriction-source-mismatch",
                "mode-restriction-source-insufficient",
                "mode-restriction-mode-mismatch",
                "mode-restriction-route-mismatch",
                "mode-restriction-corridor-mismatch",
                "mode-restriction-centerline-mismatch",
                "incomplete-mode-restriction-evidence",
                "mode-restriction-receipt-identity-mismatch"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "source_receipt"],
          "properties": {
            "status": { "const": "available" },
            "reason": { "const": "complete-version-bound-mode-restriction-receipt" },
            "source_receipt": { "$ref": "#/$defs/sourceReceipt" }
          }
        }
      ]
    }
  }
}
