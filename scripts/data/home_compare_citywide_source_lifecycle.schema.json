{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engagement-project.invalid/schemas/home_compare_citywide_source_lifecycle.schema.json",
  "title": "Home Compare citywide source lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry",
    "observation",
    "status",
    "scope",
    "receipts",
    "privacy",
    "authority",
    "limitations",
    "identity"
  ],
  "properties": {
    "schema": {
      "const": "engagement-home-compare-citywide-source-lifecycle/v1"
    },
    "registry": {
      "$ref": "#/$defs/inputArtifact"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "semantic_identity", "sha256", "bytes", "generated_at"],
      "properties": {
        "schema": { "const": "engagement-home-compare-source-smoke/v1" },
        "semantic_identity": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "generated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "status": { "enum": ["partial", "unavailable"] },
    "scope": { "const": "philadelphia-citywide-aggregate-metadata" },
    "receipts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "citygeo-address-locator" }, "ordinal": { "const": 0 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "opa-current-property" }, "ordinal": { "const": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "opa-assessment-history" }, "ordinal": { "const": 2 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "real-estate-transfers" }, "ordinal": { "const": 3 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "philly311-requests" }, "ordinal": { "const": 4 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "li-property-history" }, "ordinal": { "const": 5 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "vacant-property-indicators" }, "ordinal": { "const": 6 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "philadelphia-reported-crime" }, "ordinal": { "const": 7 } } }] },
        { "allOf": [{ "$ref": "#/$defs/sourceReceipt" }, { "type": "object", "properties": { "source_id": { "const": "vision-zero-hin-2025" }, "ordinal": { "const": 8 } } }] }
      ],
      "items": false
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_metadata_only", "source_rows_included", "private_values_included"],
      "properties": {
        "aggregate_metadata_only": { "const": true },
        "source_rows_included": { "const": false },
        "private_values_included": { "const": false }
      }
    },
    "authority": { "$ref": "#/$defs/authority" },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "identity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nullableTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nullableNonNegativeInteger": {
      "oneOf": [
        { "$ref": "#/$defs/nonNegativeInteger" },
        { "type": "null" }
      ]
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256", "bytes"],
      "properties": {
        "schema": { "const": "engagement-home-compare-source-registry/v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_authority",
        "publication_authority",
        "redistribution_authority",
        "safety_authority",
        "routing_authority"
      ],
      "properties": {
        "product_authority": { "const": false },
        "publication_authority": { "const": false },
        "redistribution_authority": { "const": false },
        "safety_authority": { "const": false },
        "routing_authority": { "const": false }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "ordinal",
        "registry_source_identity",
        "status",
        "evidence_kind",
        "identity",
        "freshness",
        "coverage",
        "dq",
        "licence",
        "reuse",
        "claims",
        "authority",
        "semantic_identity",
        "clocks",
        "receipt_identity"
      ],
      "properties": {
        "schema": { "const": "engagement-home-compare-citywide-source-receipt/v1" },
        "source_id": {
          "enum": [
            "citygeo-address-locator",
            "opa-current-property",
            "opa-assessment-history",
            "real-estate-transfers",
            "philly311-requests",
            "li-property-history",
            "vacant-property-indicators",
            "philadelphia-reported-crime",
            "vision-zero-hin-2025"
          ]
        },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 8 },
        "registry_source_identity": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["available", "available-zero", "partial", "unavailable"] },
        "evidence_kind": {
          "enum": [
            "bounded-metadata-observation",
            "m1-warehouse-admission-receipt",
            "hin-snapshot-receipt"
          ]
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_revision", "payload_identity", "schema_identity"],
          "properties": {
            "source_revision": {
              "oneOf": [
                { "type": "string", "minLength": 1, "maxLength": 240 },
                { "type": "null" }
              ]
            },
            "payload_identity": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "schema_identity": { "$ref": "#/$defs/sha256" }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "max_age_days", "age_days"],
          "properties": {
            "status": { "enum": ["current", "stale", "unavailable"] },
            "max_age_days": { "type": "integer", "minimum": 1, "maximum": 366 },
            "age_days": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                { "type": "null" }
              ]
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "status",
            "row_count",
            "available_zero",
            "exact_payload",
            "completeness_admitted"
          ],
          "properties": {
            "scope": { "const": "citywide" },
            "status": { "enum": ["complete-exact-receipt", "exact-receipt-review-incomplete", "bounded-metadata-only", "unavailable"] },
            "row_count": { "$ref": "#/$defs/nullableNonNegativeInteger" },
            "available_zero": { "type": "boolean" },
            "exact_payload": { "type": "boolean" },
            "completeness_admitted": { "type": "boolean" }
          }
        },
        "dq": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_field_count", "missing_fields", "flags"],
          "properties": {
            "status": { "enum": ["pass", "partial", "unavailable"] },
            "observed_field_count": { "type": "integer", "minimum": 0, "maximum": 250 },
            "missing_fields": {
              "type": "array",
              "maxItems": 250,
              "items": { "type": "string", "minLength": 1, "maxLength": 800 }
            },
            "flags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "redistribution_authority"],
          "properties": {
            "status": { "const": "not-admitted-for-redistribution" },
            "redistribution_authority": { "const": false }
          }
        },
        "reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receipt_identity",
            "receipt_sha256",
            "receipt_bytes",
            "payload_sha256",
            "payload_bytes"
          ],
          "properties": {
            "kind": { "enum": ["none", "m1-warehouse-admission-receipt", "hin-snapshot-receipt"] },
            "receipt_identity": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "receipt_sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "receipt_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
            "payload_sha256": {
              "oneOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "payload_bytes": { "$ref": "#/$defs/nullableNonNegativeInteger" }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_snapshot_claimed",
            "current_safety_claimed",
            "raw_crash_data_claimed",
            "routing_claimed"
          ],
          "properties": {
            "full_snapshot_claimed": { "const": false },
            "current_safety_claimed": { "const": false },
            "raw_crash_data_claimed": { "const": false },
            "routing_claimed": { "const": false }
          }
        },
        "authority": { "$ref": "#/$defs/authority" },
        "semantic_identity": { "$ref": "#/$defs/sha256" },
        "clocks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_as_of", "retrieved_at", "built_at", "observed_at"],
          "properties": {
            "source_as_of": { "$ref": "#/$defs/nullableTimestamp" },
            "retrieved_at": { "$ref": "#/$defs/nullableTimestamp" },
            "built_at": { "$ref": "#/$defs/nullableTimestamp" },
            "observed_at": { "$ref": "#/$defs/timestamp" }
          }
        },
        "receipt_identity": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
