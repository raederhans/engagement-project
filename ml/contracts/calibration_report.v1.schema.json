{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engagement-project.local/ml/contracts/CalibrationReport/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluation_scope", "research_only", "authority", "privacy", "benchmark_report_identity", "dataset_manifest_identity", "split_policy_identity", "calibration_policy_identity", "candidate_calibration", "gate", "report_identity"],
  "properties": {
    "schema": { "const": "CalibrationReport/v1" },
    "evaluation_scope": { "enum": ["full-exact-registry", "synthetic-fixture"] },
    "research_only": { "const": true },
    "authority": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/authority" },
    "privacy": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/privacy" },
    "benchmark_report_identity": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/sha256" },
    "dataset_manifest_identity": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/sha256" },
    "split_policy_identity": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/sha256" },
    "calibration_policy_identity": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/sha256" },
    "candidate_calibration": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["model", "method", "primary_slice_count", "coverage_minimum", "coverage_maximum", "coverage_median", "failed_slices", "passed"],
        "properties": { "model": { "type": "string" }, "method": { "type": "string" }, "primary_slice_count": { "type": "integer", "minimum": 0 }, "coverage_minimum": { "type": ["number", "null"] }, "coverage_maximum": { "type": ["number", "null"] }, "coverage_median": { "type": ["number", "null"] }, "failed_slices": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "passed": { "type": "boolean" } }
      }
    },
    "gate": { "type": "object", "additionalProperties": false, "required": ["passed", "all_primary_slices_required"], "properties": { "passed": { "type": "boolean" }, "all_primary_slices_required": { "const": true } } },
    "report_identity": { "$ref": "https://engagement-project.local/ml/contracts/ModelBenchmarkReport/v1#/$defs/sha256" }
  }
}
